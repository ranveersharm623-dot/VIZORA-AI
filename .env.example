PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://user:pass@host:5432/vizora
JWT_SECRET=change-me-to-a-long-random-string
# Google Gemini image generation (server-side only)
GEMINI_API_KEY=
# Optional: override the image model name
GEMINI_IMAGE_MODEL=
# FamGateway (server-side only, never sent to the browser)
FAMGATEWAY_API_KEY=
# Public HTTPS address of this site (used for payment return + webhook)
APP_URL=https://yourdomain.com
